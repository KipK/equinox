  "sections": [
    {
      "id": "overview",
      "title_key": "sections.overview.title",
      "icon": "mdi:sine-wave",
      "summary_key": "sections.overview.summary",
      "items": [
        {
          "type": "hero_status",
          "title_key": "hero.title",
          "subtitle_key": "hero.subtitle",
          "icon": "mdi:sine-wave",
          "tone": "info"
        },
        {
          "type": "layout_grid",
          "min_width": 260,
          "items": [
            {
              "type": "metric_grid",
              "title_key": "groups.power",
              "metrics": [
                {
                  "label_key": "metrics.on_percent",
                  "source": "climate",
                  "path": "on_percent",
                  "format": "number",
                  "value_multiplier": 100,
                  "digits": 0,
                  "unit": "%"
                },
                {
                  "label_key": "metrics.power_percent",
                  "source": "climate",
                  "path": "power_percent",
                  "format": "number",
                  "digits": 0,
                  "unit": "%"
                }
              ]
            },
            {
              "type": "metric_grid",
              "title_key": "groups.coefficients",
              "visible_if": {
                "var": "climate/vtherm_over_switch/tpi_coef_int"
              },
              "metrics": [
                {
                  "label_key": "metrics.kint",
                  "source": "climate",
                  "path": "vtherm_over_switch/tpi_coef_int",
                  "format": "number",
                  "digits": 3
                },
                {
                  "label_key": "metrics.kext",
                  "source": "climate",
                  "path": "vtherm_over_switch/tpi_coef_ext",
                  "format": "number",
                  "digits": 4
                },
                {
                  "label_key": "metrics.threshold_low",
                  "source": "climate",
                  "path": "vtherm_over_switch/tpi_threshold_low",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                },
                {
                  "label_key": "metrics.threshold_high",
                  "source": "climate",
                  "path": "vtherm_over_switch/tpi_threshold_high",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                }
              ]
            },
            {
              "type": "metric_grid",
              "title_key": "groups.coefficients",
              "visible_if": {
                "var": "climate/vtherm_over_valve/tpi_coef_int"
              },
              "metrics": [
                {
                  "label_key": "metrics.kint",
                  "source": "climate",
                  "path": "vtherm_over_valve/tpi_coef_int",
                  "format": "number",
                  "digits": 3
                },
                {
                  "label_key": "metrics.kext",
                  "source": "climate",
                  "path": "vtherm_over_valve/tpi_coef_ext",
                  "format": "number",
                  "digits": 4
                },
                {
                  "label_key": "metrics.threshold_low",
                  "source": "climate",
                  "path": "vtherm_over_valve/tpi_threshold_low",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                },
                {
                  "label_key": "metrics.threshold_high",
                  "source": "climate",
                  "path": "vtherm_over_valve/tpi_threshold_high",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                }
              ]
            },
            {
              "type": "metric_grid",
              "title_key": "groups.coefficients",
              "visible_if": {
                "var": "climate/vtherm_over_climate_valve/valve_regulation/tpi_coef_int"
              },
              "metrics": [
                {
                  "label_key": "metrics.kint",
                  "source": "climate",
                  "path": "vtherm_over_climate_valve/valve_regulation/tpi_coef_int",
                  "format": "number",
                  "digits": 3
                },
                {
                  "label_key": "metrics.kext",
                  "source": "climate",
                  "path": "vtherm_over_climate_valve/valve_regulation/tpi_coef_ext",
                  "format": "number",
                  "digits": 4
                },
                {
                  "label_key": "metrics.threshold_low",
                  "source": "climate",
                  "path": "vtherm_over_climate_valve/valve_regulation/tpi_threshold_low",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                },
                {
                  "label_key": "metrics.threshold_high",
                  "source": "climate",
                  "path": "vtherm_over_climate_valve/valve_regulation/tpi_threshold_high",
                  "format": "number",
                  "digits": 1,
                  "unit": "°C"
                }
              ]
            },
            {
              "type": "metric_grid",
              "title_key": "groups.settings",
              "metrics": [
                {
                  "label_key": "metrics.cycle",
                  "source": "climate",
                  "path": "configuration/cycle_min",
                  "format": "number",
                  "digits": 0,
                  "unit_key": "units.min"
                },
                {
                  "label_key": "metrics.min_activation",
                  "source": "climate",
                  "path": "configuration/minimal_activation_delay_sec",
                  "format": "number",
                  "digits": 0,
                  "unit_key": "units.s"
                },
                {
                  "label_key": "metrics.min_deactivation",
                  "source": "climate",
                  "path": "configuration/minimal_deactivation_delay_sec",
                  "format": "number",
                  "digits": 0,
                  "unit_key": "units.s"
                }
              ]
            }
          ]
        },
        {
          "type": "history",
          "title_key": "graphs.overview",
          "range": "24h",
          "series": [
            {
              "entity": "$climate_entity",
              "attribute": "current_temperature",
              "label_key": "graphs.temperature",
              "unit": "°C",
              "scale_group": "temperature"
            },
            {
              "entity": "$climate_entity",
              "attribute": "temperature",
              "label_key": "graphs.setpoint",
              "unit": "°C",
              "scale_group": "temperature"
            },
            {
              "entity": "$climate_entity",
              "attribute": "power_percent",
              "label_key": "graphs.power",
              "unit": "%",
              "scale_group": "power"
            }
          ],
          "options": {
            "tooltip": true,
            "legend": true,
            "scales": true,
            "tools": false,
            "date_picker": false,
            "entity_picker": false,
            "range_picker": false
          }
        }
      ]
    },
    {
      "id": "learning",
      "title_key": "sections.learning.title",
      "icon": "mdi:brain",
      "summary_key": "sections.learning.summary",
      "items": [
        {
          "type": "section_note",
          "text_key": "learning.not_enabled",
          "tone": "info",
          "icon": "mdi:information-outline",
          "visible_if": {
            "!": {
              "var": "diagnostic/entity_id"
