                "power_out_of_range": {
                  "label_key": "status.prefix.power_out_of_range",
                  "tone": "muted",
                  "icon": "mdi:timer-sand"
                },
                "outdoor_delta_too_small": {
                  "label_key": "status.prefix.outdoor_delta_too_small",
                  "tone": "muted",
                  "icon": "mdi:timer-sand"
                },
                "gap_too_large_for_outdoor": {
                  "label_key": "status.prefix.gap_too_large_for_outdoor",
                  "tone": "muted",
                  "icon": "mdi:timer-sand"
                },
                "no_learning_possible": {
                  "label_key": "status.prefix.no_learning_possible",
                  "tone": "muted",
                  "icon": "mdi:timer-sand"
                }
              },
              "fallback": {
                "tone": "muted",
                "icon": "mdi:help-circle-outline"
              },
              "fallback_show_value": true
            }
          ]
        },
        {
          "type": "progress",
          "label_key": "learning.kint_windows",
          "visible_if": {
            "var": "diagnostic/entity_id"
          },
          "value": {
            "source": "diagnostic",
            "path": "coeff_int_cycles"
          },
          "target": 15,
          "digits": 0
        },
        {
          "type": "progress",
          "label_key": "learning.kext_cycles",
          "visible_if": {
            "var": "diagnostic/entity_id"
          },
          "value": {
            "source": "diagnostic",
            "path": "coeff_ext_cycles"
          },
          "target": 50,
          "digits": 0
        },
        {
          "type": "metric_grid",
          "visible_if": {
            "var": "diagnostic/entity_id"
          },
          "metrics": [
            {
              "label_key": "learning.kint",
              "source": "diagnostic",
              "path": "calculated_coef_int",
              "format": "number",
              "digits": 3
            },
            {
              "label_key": "learning.kext",
              "source": "diagnostic",
              "path": "calculated_coef_ext",
              "format": "number",
              "digits": 4
            },
            {
              "label_key": "learning.confidence",
              "source": "diagnostic",
              "path": "model_confidence",
              "format": "number",
              "value_multiplier": 100,
              "digits": 0,
              "unit": "%"
            },
            {
              "label_key": "learning.cycles",
              "source": "diagnostic",
              "path": "heating_cycles_count",
              "format": "number",
              "digits": 0
            },
            {
              "label_key": "learning.start",
              "source": "diagnostic",
              "path": "learning_start_dt",
              "format": "datetime"
            }
          ]
        },
        {
          "type": "history",
          "title_key": "learning.graph",
          "range": "7d",
          "visible_if": {
            "var": "diagnostic/entity_id"
          },
          "series": [
            {
              "entity": "$diagnostic_entity",
              "attribute": "calculated_coef_int",
              "label_key": "metrics.kint",
              "scale_group": "kint"
            },
            {
              "entity": "$diagnostic_entity",
              "attribute": "calculated_coef_ext",
              "label_key": "metrics.kext",
              "scale_group": "kext"
            }
          ],
          "options": {
            "tooltip": true,
            "legend": true,
            "scales": true,
            "tools": false,
            "date_picker": false,
            "entity_picker": false,
            "range_picker": false
          }
        },
        {
          "type": "section_note",
          "text_key": "learning.help",
          "tone": "info",
          "icon": "mdi:information-outline",
          "visible_if": {
            "var": "diagnostic/entity_id"
          }
        }
      ]
    },
    {
      "id": "actions",
      "title_key": "sections.actions.title",
      "icon": "mdi:gesture-tap-button",
      "summary_key": "sections.actions.summary",
      "items": [
        {
          "type": "section_note",
          "text_key": "learning.not_enabled",
          "tone": "info",
          "icon": "mdi:information-outline",
          "visible_if": {
            "!": {
              "var": "diagnostic/entity_id"
            }
          }
        },
        {
          "type": "action",
          "id": "auto-tpi-resume",
          "label_key": "actions.resume",
          "icon": "mdi:play-circle-outline",
          "service": "versatile_thermostat.set_auto_tpi_mode",
          "target": {
            "entity_id": "$climate_entity"
          },
          "data": {
            "auto_tpi_mode": true,
            "reinitialise": false
          },
          "visible_if": {
            "and": [
              {
                "var": "diagnostic/entity_id"
              },
              {
                "!=": [
                  {
                    "var": "diagnostic/state"
                  },
                  "active"
                ]
              }
            ]
          },
          "confirmation": {
            "enabled": true,
            "text_key": "actions.resume.confirm"
          }
        },
        {
          "type": "action",
          "id": "auto-tpi-start",
          "label_key": "actions.start",
          "icon": "mdi:restart",
          "service": "versatile_thermostat.set_auto_tpi_mode",
          "target": {
            "entity_id": "$climate_entity"
          },
          "data": {
            "auto_tpi_mode": true,
            "reinitialise": true
          },
          "visible_if": {
            "and": [
              {
                "var": "diagnostic/entity_id"
              },
              {
                "!=": [
                  {
                    "var": "diagnostic/state"
                  },
                  "active"
                ]
              }
            ]
          },
          "confirmation": {
            "enabled": true,
            "text_key": "actions.start.confirm"
          }
        },
        {
          "type": "action",
          "id": "auto-tpi-stop",
          "label_key": "actions.stop",
          "icon": "mdi:stop-circle-outline",
          "service": "versatile_thermostat.set_auto_tpi_mode",
          "target": {
            "entity_id": "$climate_entity"
          },
          "data": {
            "auto_tpi_mode": false,
            "reinitialise": false
          },
          "visible_if": {
            "==": [
              {
                "var": "diagnostic/state"
              },
              "active"
            ]
          },
          "confirmation": {
            "enabled": true,
            "text_key": "actions.stop.confirm"
          }
        }
      ]
    }
  ]
}
